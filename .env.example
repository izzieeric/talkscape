# 后端环境变量
# 复制为 .env 使用；如需本机私有覆盖，建议创建 .env.local
# 可选支持：.env.{NODE_ENV}、.env.{NODE_ENV}.local
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
AUTH_ALLOW_REGISTER=true
CONVERSATION_MAX_TURNS=50

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=talkscape
DB_PASSWORD=change_this_database_password
DB_NAME=talkscape
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# DeepSeek API Key
# 文档: https://api-docs.deepseek.com/zh-cn/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 火山引擎方舟 API Key
# 文档: https://www.volcengine.com/docs/82379/1330626?lang=zh
# 默认兼容 OpenAI SDK Base URL: https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=your_volcengine_ark_api_key_here

# 火山引擎新版语音 API Key（无需 App ID）
VOLCENGINE_SPEECH_API_KEY=your_speech_api_key_here
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# 若切换到 OpenAI 官方，配置此项
# OPENAI_API_KEY=your_openai_api_key_here
# 或使用能力级变量分别覆盖
# AI_CHAT_API_KEY=your_chat_api_key_here
# AI_VOICE_API_KEY=your_voice_api_key_here

# TTS 语音配置
# 火山引擎 voice_type；具体值以控制台开通的音色为准
TTS_VOICE=zh_female_vv_uranus_bigtts
TTS_SPEED=1.0

# 可选：统一覆盖聊天 AI 默认配置
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com
# AI_CHAT_MODEL=deepseek-v4-flash

# 推荐：按能力分别配置
# AI_CHAT_PROVIDER=deepseek
# AI_CHAT_BASE_URL=https://api.deepseek.com
# AI_CHAT_MODEL=deepseek-v4-flash
# 若切到火山引擎方舟聊天，可改为：
# AI_CHAT_PROVIDER=volcengine
# AI_CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AI_CHAT_MODEL=doubao-seed-2-1-pro-260628
AI_VOICE_PROVIDER=volcengine
AI_VOICE_BASE_URL=https://openspeech.bytedance.com
AI_TTS_MODEL=seed-tts-2.0
AI_STT_MODEL=bigmodel

# 前端请求后端地址
VITE_API_BASE_URL=http://localhost:3000/talkscape
# 兼容旧变量名
# VUE_APP_API_BASE_URL=http://localhost:3000
